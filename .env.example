# Required for Prisma (local: SQLite file; production: use Turso, Neon, or Vercel Postgres)
DATABASE_URL="file:./prisma/dev.db"

# Site URL (sitemap, emails, checkout links)
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# Auth (generate with: openssl rand -base64 32)
JWT_SECRET="change-me"

# Optional: real-time admin inventory/orders (separate Node server; not on Vercel serverless)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
